# Live & Learn Brazil — Apache / LiteSpeed (Hostinger)
# Sem redirecionamento automático por idioma: cada visitante escolhe no seletor.

AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# ---- Forçar HTTPS e remover o www (um único redirecionamento 301) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://liveandlearnbrazil.com%{REQUEST_URI} [L,R=301,NE]
</IfModule>

# ---- Página de erro ----
ErrorDocument 404 /404.html

# ---- Cache dos assets estáticos ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Compressão ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css image/svg+xml application/json
</IfModule>

# ---- Arquivos de trabalho que não devem ser servidos ----
<FilesMatch "^(LEIA-ME\.txt|LICENCA-.*\.txt|\.gitignore)$">
  Require all denied
</FilesMatch>

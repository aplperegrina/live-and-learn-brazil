# Live & Learn Brazil — Apache / LiteSpeed (Hostinger)
# Sem redirecionamento automático por idioma: cada visitante escolhe no seletor.

AddDefaultCharset UTF-8
DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

# ---- Forçar HTTPS e remover o www (um único redirecionamento 301) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://liveandlearnbrazil.com%{REQUEST_URI} [L,R=301,NE]
</IfModule>

# ---- Página de erro ----
ErrorDocument 404 /404.html

# ---- Cache dos assets estáticos ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/x-httpd-php "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  # HTML, PHP e o JSON de dados do dashboard (atualizado todo dia útil): sempre revalidar
  <FilesMatch "\.(html|json|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Compressão ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css image/svg+xml application/json
</IfModule>

# ---- Arquivos de trabalho e de configuração que não devem ser servidos (403) ----
# Por nome exato
<FilesMatch "^(LEIA-ME\.txt|LICENCA-.*\.txt|\.gitignore|\.htpasswd|\.env(\..*)?)$">
  Require all denied
</FilesMatch>
# Por extensão: textos de trabalho, scripts, workflows, chaves
<FilesMatch "\.(md|py|yml|yaml|pem|key)$">
  Require all denied
</FilesMatch>
# Pastas inteiras: scripts/ (Node e Python do workflow) e .github/
<IfModule mod_rewrite.c>
  RewriteRule ^(scripts|\.github)(/|$) - [F,L]
</IfModule>
